# ── Supabase ────────────────────────────────────────────────────────────────
# Dashboard Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Clé secrète — jamais de préfixe NEXT_PUBLIC_, jamais exposée au navigateur.
# Utilisée uniquement par les route handlers app/api/**/route.ts (création /
# suppression de comptes par un admin) et par scripts/seed-demo-users.mjs.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Compte démo affiché sur la page de connexion (rôle « user », sans privilège).
# Sans NEXT_PUBLIC_DEMO_PASSWORD, le bloc n'apparaît pas.
# En production, il faut en plus NEXT_PUBLIC_SHOW_DEMO_ACCOUNT=true.
# NEXT_PUBLIC_DEMO_PASSWORD=
# NEXT_PUBLIC_SHOW_DEMO_ACCOUNT=true

# Mots de passe des comptes de démonstration, lus par scripts/seed-demo-users.mjs.
# Superuser et admin : 12 caractères minimum. Ne jamais les committer.
# SEED_SUPERUSER_PASSWORD=
# SEED_ADMIN_PASSWORD=
# SEED_DEMO_PASSWORD=
